{
  "openapi": "3.0.3",
  "info": {
    "title": "OllamaCloud native API smoke contract",
    "version": "1.0.0",
    "description": "Routes and response shapes reused from Ollama clients and docs.ollama.com/api. Local smoke fixtures; not a full provider specification."
  },
  "paths": {
    "/api/tags": {
      "get": {
        "responses": {
          "200": {
            "description": "Successful native Ollama response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "models": [
                    {
                      "name": "test-model",
                      "model": "test-model"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "responses": {
          "200": {
            "description": "Successful native Ollama response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "model": "test-model",
                  "message": {
                    "role": "assistant",
                    "content": "pong"
                  },
                  "done": true
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "complete": {
                    "value": "{\"done\":false}\n{\"done\":true}\n"
                  },
                  "providerError": {
                    "value": "{\"error\":\"synthetic provider failure\"}\n"
                  }
                }
              }
            }
          }
        },
        "description": "Native Ollama JSON or NDJSON. Streaming HTTP 200 can contain an error object. A valid stream ends with a boolean done:true record; clients must reject corruption or EOF without completion. Terminal-only and no-trailing-newline records are valid.",
        "parameters": [
          {
            "name": "x-stream-fault",
            "in": "header",
            "required": false,
            "description": "Local simulation fixture only. Never send this header to the hosted provider.",
            "schema": {
              "type": "string",
              "enum": [
                "missing-done",
                "error-then-done",
                "malformed-then-done"
              ]
            }
          }
        ]
      }
    },
    "/api/generate": {
      "post": {
        "responses": {
          "200": {
            "description": "Successful native Ollama response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "model": "test-model",
                  "response": "generated text",
                  "done": true
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "complete": {
                    "value": "{\"done\":false}\n{\"done\":true}\n"
                  },
                  "providerError": {
                    "value": "{\"error\":\"synthetic provider failure\"}\n"
                  }
                }
              }
            }
          }
        },
        "description": "Native Ollama JSON or NDJSON. Streaming HTTP 200 can contain an error object. A valid stream ends with a boolean done:true record; clients must reject corruption or EOF without completion. Terminal-only and no-trailing-newline records are valid."
      }
    },
    "/api/embed": {
      "post": {
        "responses": {
          "200": {
            "description": "Successful native Ollama response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "embeddings": [
                    [
                      1.0,
                      2.0,
                      3.0
                    ]
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
