<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Version>4.0.0</Version>
    <PackageReleaseNotes>4.0.0: one client per provider (OpenAiClient, AnthropicClient, ...) with every operation and a checked capability matrix; OpenAiClient on the Responses API and OpenAiCompatibleClient for Chat Completions servers; citations, RawResponse, and AppliedReasoningEffort on every response. Breaking: see MIGRATION_V3_TO_V4.md and CHANGELOG.md at https://github.com/jchristn/PolyPrompt.</PackageReleaseNotes>
    <Authors>Joel Christner</Authors>
    <Company>Joel Christner</Company>
    <Copyright>(c)2026 Joel Christner</Copyright>
    <PackageId>PolyPrompt</PackageId>
    <Description>PolyPrompt is a lightweight, unified .NET library for chat, tool calling, text generation, embeddings, reranking, classification, decision models, and model catalogs, with one client per provider: OpenAI (Responses API), OpenAI-compatible servers (vLLM, Ollama /v1, LM Studio, gateways), Azure OpenAI, xAI Grok, Anthropic Claude, Google Gemini, Google Vertex AI, AWS Bedrock, Ollama, Ollama Cloud, Cohere, VoyageAI, Hugging Face Text Embeddings Inference (TEI), and TypeSafe (Jev, Ollaya). Every client exposes every operation; unsupported ones throw CapabilityNotSupportedException, and client.Supports checks first. It also drives local agent harnesses (Claude Code, Codex, Gemini CLI, Cursor CLI, Mux, Pi, and OpenCode) as shell-free child processes with streamed agent events, session resume, bounded output, timeouts, and process-tree cancellation. Native AOT compatible.</Description>
    <PackageProjectUrl>https://github.com/jchristn/PolyPrompt</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jchristn/PolyPrompt</RepositoryUrl>
    <RepositoryType>Github</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>llm;ai;ollama;ollamacloud;openai;responses-api;openai-compatible;vllm;lm-studio;xai;grok;azure;gemini;vertex;anthropic;claude;bedrock;aws;gcp;sigv4;voyageai;voyage;cohere;tei;huggingface;text-embeddings-inference;rerank;reranking;classification;opentelemetry;telemetry;metrics;tracing;observability;sparse;rag;chat;completion;embedding;generation;streaming;tools;function-calling;decision;typesafe;jev;ollaya;aot;native-aot;trimming;agent;agents;harness;cli;claude-code;codex;gemini-cli;cursor;cursor-cli;mux;pi;opencode</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>PolyPrompt.xml</DocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS1998;CS8600;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
    <WarningsAsErrors Condition="'$(Configuration)' == 'Release'">$(WarningsAsErrors);CS1591;CS1572;CS1573;CS1574</WarningsAsErrors>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <Title>PolyPrompt</Title>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\logo.png" Pack="true" PackagePath="\" />
    <None Include="..\..\llms.txt" Pack="true" PackagePath="\" />
    <None Include="PolyPrompt.xml" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SyslogLogging" Version="2.4.0" />
  </ItemGroup>

</Project>
